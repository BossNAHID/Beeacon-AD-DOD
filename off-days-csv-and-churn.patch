+/* 30+ days churn / inactive.
+   Current-window zero-run alone can be misleading: a merchant with zero orders for the whole
+   window may have churned last month (real loss) or may simply never have shipped / been dormant
+   for 60+ days. Last month's totals (m.prev) separate those two groups.
+     Churned  = 30+ days inactive AND had orders last month
+     Dormant  = 30+ days inactive AND no orders last month (or no last-month record)
+   If last-month data isn't loaded, rows are listed as "Unverified". */
+const CHURN_DAYS = 30;
+function lastOrderIdx(orders){
+  for (let j = orders.length - 1; j >= 0; j--){ if (Number(orders[j]) > 0) return j; }
+  return -1;
+}
+function churnInfo(m){
+  const orders = safeOrders(m.orders);
+  const days = flaggedDays(orders);
+  const winLen = STATE.dates.length;
+  const hasPrevMonth = !!STATE.previousMonthLabel;
+  const prevOrders = m.prev ? (Number(m.prev.orders) || 0) : 0;
+  const prevRevenue = m.prev ? (Number(m.prev.revenue) || 0) : 0;
+  const allZeroWindow = winLen > 0 && days === winLen;
+  // Qualifies on the window alone, or (window shorter than 30d, all zero) + silent all of last month.
+  const qualifies = days >= CHURN_DAYS || (allZeroWindow && hasPrevMonth && prevOrders === 0);
+  let segment = 'unverified';
+  if (hasPrevMonth) segment = prevOrders > 0 ? 'churned' : 'dormant';
+  return { days, allZeroWindow, qualifies, segment, prevOrders, prevRevenue };
+}
+function churnDaysLabel(ci){
+  // Whole window silent => real gap is longer than what we can see, so show "31+" not "31".
+  return ci.allZeroWindow ? ci.days + '+' : String(ci.days);
+}
+function churnLastOrderText(m, ci){
+  const idx = lastOrderIdx(safeOrders(m.orders));
+  if (idx !== -1) return fmtDate(STATE.dates[idx]);
+  return ci.prevOrders > 0 ? 'Before ' + fmtDate(STATE.dates[0]) : '–';
+}
+const SEGMENT_LABEL = { churned: 'Churned', dormant: 'Dormant', unverified: 'Unverified' };
